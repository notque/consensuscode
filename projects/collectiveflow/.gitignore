# CollectiveFlow gitignore
# We want to track proposals and decisions in git for transparency

# Binary (only at this directory level, not cmd/collectiveflow/)
/collectiveflow

# Temporary files
*.tmp
*.swp

# Config files with potential secrets (if any)
# Note: We actually want to track most config for transparency

# Logs (if we add logging)
*.log

# SQLite databases (generated from YAML source data)
*.db
*.db-wal
*.db-shm
# Exception: the migrated collectiveflow database is committed so any agent
# can use SQLite immediately without running the migration script.
!data/collectiveflow.db

# Python bytecode
__pycache__/
*.pyc